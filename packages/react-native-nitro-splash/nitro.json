{
	"$schema": "https://nitro.margelo.com/nitro.schema.json",
	"cxxNamespace": ["nitrosplash"],
	"ios": {
		"iosModuleName": "Nitrosplash"
	},
	"android": {
		"androidNamespace": ["nitrosplash"],
		"androidCxxLibName": "Nitrosplash"
	},
	"autolinking": {
		"Splashscreen": {
			"ios": {
				"language": "swift",
				"implementationClassName": "HybridSplashscreen"
			},
			"android": {
				"language": "kotlin",
				"implementationClassName": "HybridSplashscreen"
			}
		}
	},
	"ignorePaths": ["**/node_modules"]
}
